---
import Typewriter from "./Typewriter";
---
<section class="min-h-screen flex items-center justify-center px-4 relative overflow-hidden">
  <!-- Fundo com grid -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(0,240,255,0.03)_0,_transparent_70%)]"></div>
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-10"></div>

  <div class="max-w-5xl mx-auto text-center relative z-10">
    <h1 class="text-5xl md:text-7xl font-extrabold bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent mb-6">
      Olá, eu sou Adan William
    </h1>
    
    <div class="text-xl md:text-3xl font-mono text-zinc-300 mb-8 h-16 flex items-center justify-center">
      <Typewriter client:load />
    </div>
    
    <p class="text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto mb-10">
      Analista de TI e Desenvolvedor Full Stack • Especialista em Observabilidade e Sistemas Escaláveis
    </p>
    
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="#projects" class="px-8 py-4 bg-gradient-to-r from-cyan-500 to-purple-500 rounded-xl font-semibold hover:scale-105 transition-transform shadow-lg shadow-cyan-500/25">
        Ver Projetos ↓
      </a>
      <a href="https://www.linkedin.com/in/adan-william-9593163b3/" target="_blank" class="px-8 py-4 bg-zinc-800 rounded-xl font-semibold hover:bg-zinc-700 transition-colors border border-zinc-700">
        LinkedIn
      </a>
      <a href="https://github.com/adanwilliamdev" target="_blank" class="px-8 py-4 bg-zinc-800 rounded-xl font-semibold hover:bg-zinc-700 transition-colors border border-zinc-700">
        GitHub
      </a>
    </div>
  </div>
</section>
