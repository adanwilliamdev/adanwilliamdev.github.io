---
const techs = [
  { name: "Java", icon: "☕", color: "border-orange-400" },
  { name: "Spring Boot", icon: "🌱", color: "border-green-400" },
  { name: "React", icon: "⚛️", color: "border-cyan-400" },
  { name: "TypeScript", icon: "📘", color: "border-blue-400" },
  { name: "Node.js", icon: "🟢", color: "border-green-500" },
  { name: "PostgreSQL", icon: "🐘", color: "border-blue-500" },
  { name: "Docker", icon: "🐳", color: "border-blue-300" },
  { name: "Kubernetes", icon: "☸️", color: "border-blue-600" },
  { name: "AWS", icon: "☁️", color: "border-yellow-400" },
  { name: "Git", icon: "🔀", color: "border-orange-500" },
];
---
<section id="tech" class="py-20 px-4 bg-zinc-900/30">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">
        Tech Stack
      </h2>
      <p class="text-zinc-400 mt-2">Tecnologias que domino</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
      {techs.map((tech) => (
        <div
          key={tech.name}
          class={`p-4 bg-zinc-800/50 rounded-xl border-2 ${tech.color} text-center hover:scale-105 transition-transform hover:shadow-xl hover:shadow-cyan-500/10`}
        >
          <div class="text-4xl mb-2">{tech.icon}</div>
          <span class="text-sm font-mono text-zinc-300">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
