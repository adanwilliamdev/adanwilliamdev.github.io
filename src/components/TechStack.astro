---
const groups = [
  { title: "Backend (foco)", items: ["Java", "Spring Boot", "Spring Security (JWT)", "Spring Data JPA / Hibernate", "Spring Cloud Gateway", "Spring AI", "APIs REST", "Microsserviços"] },
  { title: "Dados e infra", items: ["PostgreSQL", "Redis", "Flyway", "Docker", "Docker Compose", "Maven", "Linux", "Git", "GitHub Actions"] },
  { title: "Frontend", items: ["React", "TypeScript", "Angular", "Next.js", "Tailwind CSS", "Thymeleaf"] },
  { title: "Qualidade", items: ["JUnit 5", "Mockito", "Testcontainers", "Jest", "Pytest", "Swagger / OpenAPI"] },
  { title: "Também já usei", items: ["Python (FastAPI)", "Node.js (Express, Prisma)", "SQLAlchemy", "WebSocket", "MCP"] },
  { title: "Operação (ISP)", items: ["Zabbix", "PRTG", "Observabilidade", "SLA", "Runbooks"] },
];
---
<section id="tech" class="py-28 px-4 border-y border-line bg-surface/40">
  <div class="max-w-6xl mx-auto">
    <div class="mb-14" data-reveal>
      <span class="eyebrow">Tecnologias</span>
      <h2 class="text-4xl md:text-5xl font-semibold mt-4">Tech stack</h2>
      <p class="text-ink-dim mt-3">Foco em Java e Spring Boot com PostgreSQL, Redis e Docker. Python, Node.js e frontend moderno como complemento.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {groups.map((g, i) => (
        <div class="panel panel-hover p-7" data-reveal style={`--d:${i * 80}ms`}>
          <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-signal">{g.title}</h3>
          <div class="flex flex-wrap gap-2 mt-5">
            {g.items.map((t) => <span class="tag !text-[0.8rem] !px-3 !py-1.5">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
