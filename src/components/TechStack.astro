---
const groups = [
  { label: "Backend", items: ["Java", "Spring Boot", "Spring Security", "Python", "FastAPI"] },
  { label: "Frontend", items: ["React", "TypeScript"] },
  { label: "Dados", items: ["PostgreSQL", "Redis"] },
  { label: "Infra", items: ["Docker", "Git", "Linux"] },
];
---
<section id="stack" class="py-24 px-5 border-y border-[var(--color-line-soft)]">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12">
      <span class="eyebrow">Tecnologias</span>
      <h2 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold text-[var(--color-ink)] mt-3">
        Stack
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
      {groups.map((group) => (
        <div>
          <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-ink-faint)] uppercase tracking-wider">
            {group.label}
          </span>
          <ul class="mt-3 space-y-2">
            {group.items.map((item) => (
              <li class="text-sm text-[var(--color-ink-dim)]">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-ink-faint)] mt-12">
      Estudando: Kubernetes, AWS, arquitetura de microsserviços, observabilidade moderna.
    </p>
  </div>
</section>
