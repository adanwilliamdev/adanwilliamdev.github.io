---
const groups = [
  { title: "Backend", items: ["Python", "FastAPI", "Pydantic", "SQLAlchemy", "Alembic", "Socket.IO", "WebSocket", "JWT", "Node.js", "Java / Spring Boot", ".NET"] },
  { title: "Frontend", items: ["Next.js", "React", "TypeScript", "Tailwind CSS", "TanStack Query", "shadcn/ui", "Zod"] },
  { title: "Dados & mensageria", items: ["PostgreSQL", "Redis", "RabbitMQ", "SQL Server", "MongoDB"] },
  { title: "Infra & observabilidade", items: ["Docker", "Kubernetes", "Linux", "Zabbix", "PRTG", "Prometheus", "Grafana", "Git", "GitHub Actions"] },
];
---
<section id="tech" class="py-28 px-4 border-y border-line bg-surface/40">
  <div class="max-w-6xl mx-auto">
    <div class="mb-14" data-reveal>
      <span class="eyebrow">Tecnologias</span>
      <h2 class="text-4xl md:text-5xl font-semibold mt-4">Tech stack</h2>
      <p class="text-ink-dim mt-3">Ferramentas que uso no dia a dia, organizadas por camada.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {groups.map((g, i) => (
        <div class="panel panel-hover p-7" data-reveal style={`--d:${i * 80}ms`}>
          <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-signal">{g.title}</h3>
          <div class="flex flex-wrap gap-2 mt-5">
            {g.items.map((t) => <span class="tag !text-[0.8rem] !px-3 !py-1.5">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
