---
const roles = [
  {
    period: "2021 — 2026",
    title: "Analista de TI",
    org: "Infraestrutura e Desenvolvimento",
    items: [
      "Administração de servidores Windows e Linux",
      "Monitoramento de infraestrutura com Zabbix e Grafana",
      "Suporte N2/N3 e resolução de incidentes críticos",
      "Automação com Python e PowerShell",
      "Desenvolvimento Full Stack para gestão corporativa",
    ],
  },
  {
    period: "2020 — 2021",
    title: "Técnico de Suporte",
    org: "Infraestrutura e Redes",
    items: [
      "Manutenção de redes e servidores",
      "Atendimento a chamados e resolução de problemas",
      "Configuração de firewall e segurança",
      "Implementação de melhorias na infraestrutura",
    ],
  },
];
---
<section id="experience" class="py-28 px-4 max-w-6xl mx-auto">
  <div class="mb-16">
    <span class="eyebrow">Experiência</span>
    <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl font-bold text-[var(--color-ink)] mt-4">
      Trajetória profissional
    </h2>
    <p class="text-[var(--color-ink-dim)] mt-3">5+ anos construindo e sustentando soluções em ambientes corporativos.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {roles.map((role) => (
      <div class="panel panel-hover p-7">
        <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-signal)]">{role.period}</span>
        <h3 class="text-2xl font-[family-name:var(--font-display)] font-semibold text-[var(--color-ink)] mt-2">{role.title}</h3>
        <p class="text-[var(--color-ink-dim)] font-medium">{role.org}</p>
        <ul class="mt-5 space-y-2.5">
          {role.items.map((item) => (
            <li class="flex items-start gap-2.5 text-sm text-[var(--color-ink-dim)]">
              <span class="text-[var(--color-signal)] mt-0.5 font-[family-name:var(--font-mono)]">▸</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
