---
const roles = [
  {
    period: "Nov 2020 — Ago 2026",
    title: "Analista de TI",
    org: "Conectv · Pirapora, MG",
    items: [
      "Monitoramento proativo da infraestrutura de mais de 12.500 clientes em ambiente ISP, com Zabbix e PRTG",
      "Atuação N2/N3 na resolução de incidentes críticos",
      "Runbooks e padronização de diagnósticos, reduzindo o MTTR em cerca de 20%",
      "Scripts de automação para servidores Linux e Windows, economizando de 5 a 8 horas semanais da equipe",
      "Aplicação de monitoramento de rede em tempo real, em Java, usada diariamente por 10 a 15 colaboradores",
      "Reescrita da solução em Python/FastAPI e Next.js, que deu origem ao OrbNOC",
    ],
  },
  {
    period: "Meados de 2025 — hoje",
    title: "Desenvolvimento de software",
    org: "Projetos e formação · em paralelo",
    items: [
      "Projetos backend e full stack publicados no GitHub, com Docker, migrations e testes automatizados",
      "Bootcamps e cursos com Accenture, Itaú, CI&T e Instituto Federal do Rio Grande do Sul",
    ],
  },
  {
    period: "Ago 2025 — Abr 2027",
    title: "Análise e Desenvolvimento de Sistemas",
    org: "UniFatecie · tecnólogo, em andamento",
    items: [
      "Formação em engenharia de software e desenvolvimento de sistemas",
      "Aplicação prática dos estudos em projetos publicados no GitHub",
    ],
  },
];
---
<section id="experience" class="py-28 px-4 max-w-6xl mx-auto">
  <div class="mb-14" data-reveal>
    <span class="eyebrow">Experiência</span>
    <h2 class="text-4xl md:text-5xl font-semibold mt-4">Trajetória profissional</h2>
    <p class="text-ink-dim mt-3 max-w-2xl">Mais de 5 anos em infraestrutura crítica de ISP, somados ao desenvolvimento de software desde meados de 2025.</p>
  </div>

  <ol class="relative border-l border-line ml-2 space-y-8">
    {roles.map((role, i) => (
      <li class="pl-8 relative" data-reveal style={`--d:${i * 100}ms`}>
        <span class="absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full bg-signal ring-4 ring-bg"></span>
        <div class="panel panel-hover p-7">
          <span class="font-mono text-xs text-signal">{role.period}</span>
          <h3 class="text-2xl font-semibold mt-2">{role.title}</h3>
          <p class="text-ink-dim">{role.org}</p>
          <ul class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-2.5">
            {role.items.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-dim">
                <span class="text-signal font-mono mt-px">→</span><span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
