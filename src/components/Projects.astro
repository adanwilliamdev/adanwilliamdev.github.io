---
const projects = [
  {
    title: "MedFlow",
    description: "Sistema completo de gestão de clínicas médicas: cadastro de pacientes e médicos, agenda de consultas, prontuário eletrônico e controle financeiro, com dashboard de indicadores.",
    tech: ["Java 17", "Spring Boot 3", "Spring Security", "JWT", "PostgreSQL", "Redis", "RabbitMQ", "React 19"],
    link: "https://github.com/adanwilliamdev/MedFlow",
  },
  {
    title: "Minha Biblioteca",
    description: "Gerenciador full stack de filmes e séries, com importação automática via TMDB, controle de progresso por episódio e dashboard de estatísticas.",
    tech: ["Java 17", "Spring Boot 3", "JPA", "Hibernate", "PostgreSQL", "React", "TypeScript"],
    link: "https://github.com/adanwilliamdev/biblioteca-fullstack",
  },
  {
    title: "Finanças Microsserviços",
    description: "Sistema de finanças pessoais reestruturado como arquitetura de microsserviços, aplicando Spring Cloud para comunicação entre serviços.",
    tech: ["Java", "Spring Cloud", "Microsserviços"],
    link: "https://github.com/adanwilliamdev/financas-microservicos",
  },
  {
    title: "Real Estate Monitor",
    description: "Plataforma de inteligência de mercado imobiliário: previsão de preços com Random Forest, clusterização, análise de investimento (ROI, yield) e dashboard interativo.",
    tech: ["Python", "FastAPI", "Scikit-learn", "Streamlit", "Docker"],
    link: "https://github.com/adanwilliamdev/real-estate-monitor",
    note: "Explorando Python aplicado a dados",
  },
];
---
<section id="projects" class="py-24 px-5 max-w-4xl mx-auto">
  <div class="mb-12">
    <span class="eyebrow">Portfólio</span>
    <h2 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold text-[var(--color-ink)] mt-3">
      Projetos
    </h2>
  </div>

  <div class="space-y-4">
    {projects.map((project) => (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="panel panel-hover block p-6 md:p-7 group"
      >
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-xl font-[family-name:var(--font-display)] font-semibold text-[var(--color-ink)]">
            {project.title}
          </h3>
          <svg class="w-4 h-4 text-[var(--color-ink-faint)] shrink-0 mt-1.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7m10 0v10"/>
          </svg>
        </div>

        <p class="text-sm text-[var(--color-ink-dim)] mt-3 leading-relaxed max-w-2xl">
          {project.description}
        </p>

        {project.note && (
          <p class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-accent-soft)] mt-3">
            {project.note}
          </p>
        )}

        <div class="flex flex-wrap gap-2 mt-4">
          {project.tech.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <div class="text-center mt-10">
    <a href="https://github.com/adanwilliamdev" target="_blank" rel="noopener noreferrer" class="link-accent font-[family-name:var(--font-mono)] text-xs uppercase tracking-wider inline-flex items-center gap-2">
      Ver todos os repositórios →
    </a>
  </div>
</section>
