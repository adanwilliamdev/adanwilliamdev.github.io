---
const projects = [
  {
    title: "MedFlow",
    icon: "🩺",
    problem: "Clínicas médicas dependem de planilhas e sistemas fragmentados para gerenciar pacientes, agenda e prontuários, o que gera retrabalho e falhas de comunicação.",
    solution: "Sistema completo de gestão de clínicas com cadastro de pacientes e médicos, agenda de consultas, prontuário eletrônico e módulo financeiro.",
    metrics: "Dashboard com indicadores em tempo real, filas assíncronas com RabbitMQ e cache com Redis para alta performance.",
    tech: ["Java 17", "Spring Boot 3", "Spring Security", "JWT", "PostgreSQL", "Redis", "RabbitMQ", "React 19"],
    link: "https://github.com/adanwilliamdev/MedFlow",
    demo: null,
    featured: true,
    architecture: "React → Spring Boot → PostgreSQL / Redis / RabbitMQ",
  },
  {
    title: "Minha Biblioteca",
    icon: "📚",
    problem: "Organizar e acompanhar o progresso de filmes e séries assistidos manualmente é trabalhoso e pouco visual.",
    solution: "Gerenciador full stack de filmes e séries, com importação automática de dados via TMDB, controle de temporadas/episódios e dashboard de estatísticas.",
    metrics: "Autenticação JWT, controle de progresso automático e distribuição de conteúdo por gênero em tempo real.",
    tech: ["Java 17", "Spring Boot 3", "JPA", "Hibernate", "PostgreSQL", "React", "TypeScript"],
    link: "https://github.com/adanwilliamdev/biblioteca-fullstack",
    demo: null,
    featured: true,
    architecture: "React/TS → Spring Boot → JPA → PostgreSQL",
  },
  {
    title: "Finanças Microsserviços",
    icon: "💰",
    problem: "Uma aplicação monolítica de finanças pessoais limitava a escalabilidade e a manutenção independente dos módulos.",
    solution: "Reestruturação do sistema de finanças pessoais em arquitetura de microsserviços, separando responsabilidades entre serviços independentes.",
    metrics: "Comunicação entre serviços orquestrada com Spring Cloud, base para escalabilidade horizontal futura.",
    tech: ["Java", "Spring Cloud", "Microsserviços"],
    link: "https://github.com/adanwilliamdev/financas-microservicos",
    demo: null,
    featured: true,
    architecture: "Spring Cloud Gateway → Serviços independentes",
  },
  {
    title: "Real Estate Monitor",
    icon: "🏠",
    problem: "Investidores imobiliários têm dificuldade em cruzar dados de preço, região e histórico para identificar boas oportunidades de investimento.",
    solution: "Plataforma de inteligência de mercado imobiliário com previsão de preços via Machine Learning, análise de investimento (ROI, yield, payback) e dashboard interativo.",
    metrics: "Modelo Random Forest para previsão de preços, clusterização K-Means por região e ranking automático de oportunidades.",
    tech: ["Python 3.11", "FastAPI", "Scikit-learn", "Pandas", "Streamlit", "Docker", "Pytest"],
    link: "https://github.com/adanwilliamdev/real-estate-monitor",
    demo: null,
    featured: true,
    architecture: "Streamlit → FastAPI → Scikit-learn → SQLite/PostgreSQL",
  },
];
---
<section id="projects" class="py-28 px-4 max-w-6xl mx-auto">
  <div class="mb-16">
    <span class="eyebrow">Portfólio</span>
    <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl font-bold text-[var(--color-ink)] mt-4">
      Projetos em destaque
    </h2>
    <p class="text-[var(--color-ink-dim)] mt-3">Soluções que resolvem problemas reais, do backend à análise de dados.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <div class="panel panel-hover flex flex-col overflow-hidden">
        <div class="p-7 flex flex-col flex-1">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-2xl font-[family-name:var(--font-display)] font-semibold text-[var(--color-ink)] flex items-center gap-2.5">
              <span>{project.icon}</span>
              {project.title}
            </h3>
          </div>

          <p class="text-sm text-[var(--color-ink-dim)] mt-4 leading-relaxed">{project.solution}</p>

          <div class="mt-5 pl-4 border-l-2 border-[var(--color-line)] space-y-3">
            <div>
              <span class="font-[family-name:var(--font-mono)] text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]">Problema</span>
              <p class="text-sm text-[var(--color-ink-dim)] mt-1">{project.problem}</p>
            </div>
            <div>
              <span class="font-[family-name:var(--font-mono)] text-[10px] uppercase tracking-wider text-[var(--color-online)]">Impacto</span>
              <p class="text-sm text-[var(--color-ink-dim)] mt-1">{project.metrics}</p>
            </div>
          </div>

          <p class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-signal-soft)] mt-5">
            {project.architecture}
          </p>

          <div class="flex flex-wrap gap-2 mt-5">
            {project.tech.slice(0, 5).map((t) => (
              <span class="tag">{t}</span>
            ))}
            {project.tech.length > 5 && (
              <span class="tag" title={project.tech.slice(5).join(", ")}>
                +{project.tech.length - 5}
              </span>
            )}
          </div>

          <div class="mt-6 pt-5 border-t border-[var(--color-line)] flex flex-wrap gap-4">
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-[var(--color-ink-dim)] hover:text-[var(--color-signal)] transition-colors duration-200">
              Ver no GitHub
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="text-center mt-14">
    <a href="https://github.com/adanwilliamdev" target="_blank" rel="noopener noreferrer" class="btn-ghost inline-flex items-center gap-2 px-8 py-4 rounded-xl font-medium">
      Ver todos os repositórios →
    </a>
  </div>
</section>
