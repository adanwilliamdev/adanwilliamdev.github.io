---
const projects = [
  {
    title: "🛰️ OrbNOC",
    problem: "Empresas tinham dificuldade em visualizar incidentes de rede em tempo real, resultando em longos tempos de inatividade.",
    solution: "Dashboard em tempo real com topologia de rede, alertas via Telegram e ferramentas de diagnóstico integradas.",
    metrics: "Monitora centenas de dispositivos simultaneamente com atualização em tempo real via WebSocket.",
    tech: ["Next.js 14", "React 18", "TypeScript", "Node.js", "Express", "Prisma", "PostgreSQL", "Socket.IO"],
    link: "https://github.com/adanwilliamdev/OrbNOC",
    demo: "https://orbnoc-taer.onrender.com",
    featured: true,
    architecture: "React → Node.js → PostgreSQL → Docker"
  },
  {
    title: "🏢 GiroERP",
    problem: "Pequenas empresas precisavam de um sistema de gestão integrado, mas as soluções existentes eram caras e complexas.",
    solution: "ERP completo com gestão de vendas, clientes, produtos, estoque e usuários, disponível como PWA com suporte offline.",
    metrics: "Redução de 40% no tempo de geração de relatórios operacionais.",
    tech: ["Java 21", "Spring Boot 3", "JWT", "React 18", "TypeScript", "Tailwind CSS", "PostgreSQL", "Docker", "PWA"],
    link: "https://github.com/adanwilliamdev/GiroERP",
    demo: null,
    featured: true,
    architecture: "React → Spring Boot → PostgreSQL → Docker"
  },
  {
    title: "🛒 Ecommerce Full-Stack",
    problem: "Negócios online precisavam de uma plataforma de vendas completa e escalável.",
    solution: "Sistema completo de e-commerce com autenticação JWT, carrinho, processamento de pedidos e painel administrativo.",
    metrics: "Processamento de pedidos em tempo real com controle de estoque automático.",
    tech: ["Java 17", "Spring Boot 3", "JWT", "React 18", "Vite", "Tailwind CSS", "PostgreSQL", "Docker"],
    link: "https://github.com/adanwilliamdev/ecommerce-fullstack",
    demo: null,
    featured: false,
    architecture: "React → Spring Boot → PostgreSQL → Docker"
  },
  {
    title: "🤖 SVA Platform",
    problem: "Processos de recrutamento manuais eram lentos e ineficientes.",
    solution: "Plataforma com IA que analisa currículos e vagas usando TF-IDF, gerando ranking de compatibilidade.",
    metrics: "Redução de 60% no tempo de triagem de candidatos.",
    tech: ["Python 3.12", "FastAPI", "React", "TypeScript", "Tailwind CSS", "SQLAlchemy", "SQLite", "Scikit-Learn"],
    link: "https://github.com/adanwilliamdev/sva-platform",
    demo: null,
    featured: false,
    architecture: "React → FastAPI → SQLite → IA (Scikit-Learn)"
  },
];
---
<section id="projects" class="py-24 px-4 max-w-6xl mx-auto">
  <div class="text-center mb-16">
    <span class="text-sm font-mono text-red-400 badge-red px-4 py-1 rounded-full">
      PORTFÓLIO
    </span>
    <h2 class="text-4xl md:text-5xl font-bold text-white mt-4">
      Projetos em <span class="text-red-500">Destaque</span>
    </h2>
    <p class="text-zinc-400 mt-2">Soluções que resolvem problemas reais</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {projects.map((project, index) => (
      <div
        key={project.title}
        class="group relative bg-black/40 rounded-2xl border border-red-500/10 overflow-hidden transition-all duration-500 hover:scale-[1.02] hover:border-red-500/40 hover:shadow-2xl hover:shadow-red-500/10"
        style={{ animationDelay: `${index * 0.1}s` }}
      >
        <div class="relative p-6">
          {project.featured && (
            <div class="absolute top-0 right-0 px-4 py-1 bg-red-600 text-xs font-bold rounded-bl-xl shadow-lg shadow-red-500/25">
              ⭐ DESTAQUE
            </div>
          )}
          
          <h3 class="text-2xl font-bold text-white group-hover:text-red-400 transition-colors duration-300">
            {project.title}
          </h3>
          
          <div class="mt-4 p-4 bg-red-500/5 border border-red-500/20 rounded-lg">
            <span class="text-xs font-mono text-red-400 uppercase">⚠️ Problema</span>
            <p class="text-sm text-zinc-300 mt-1">{project.problem}</p>
          </div>
          
          <div class="mt-3 p-4 bg-green-500/5 border border-green-500/20 rounded-lg">
            <span class="text-xs font-mono text-green-400 uppercase">✅ Solução</span>
            <p class="text-sm text-zinc-300 mt-1">{project.solution}</p>
          </div>
          
          {project.metrics && (
            <div class="mt-3 p-3 bg-red-500/5 border border-red-500/20 rounded-lg">
              <span class="text-xs font-mono text-red-400 uppercase">📊 Impacto</span>
              <p class="text-sm text-zinc-300 mt-1">{project.metrics}</p>
            </div>
          )}
          
          <div class="mt-4 p-3 bg-black/50 border border-red-500/10 rounded-lg">
            <span class="text-xs font-mono text-red-400 uppercase">🏗️ Arquitetura</span>
            <p class="text-sm font-mono text-red-300 mt-1">{project.architecture}</p>
          </div>
          
          <div class="flex flex-wrap gap-2 mt-4">
            {project.tech.slice(0, 5).map((t) => (
              <span key={t} class="px-3 py-1 text-xs font-mono text-red-300 bg-red-950/30 rounded-full border border-red-800/50">
                {t}
              </span>
            ))}
            {project.tech.length > 5 && (
              <span 
                class="px-3 py-1 text-xs font-mono text-zinc-400 bg-black/50 rounded-full border border-zinc-700 cursor-help relative group/tooltip"
                title={project.tech.slice(5).join(', ')}
              >
                +{project.tech.length - 5}
                <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1 bg-black border border-red-500/30 rounded-lg text-xs text-zinc-300 whitespace-nowrap opacity-0 group-hover/tooltip:opacity-100 transition-opacity duration-300 pointer-events-none z-20">
                  {project.tech.slice(5).join(' • ')}
                </span>
              </span>
            )}
          </div>
          
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-zinc-500 hover:text-red-400 transition-colors duration-300">
              <span>Ver no GitHub</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-green-400 hover:text-green-300 transition-colors duration-300 border border-green-500/20 px-3 py-1 rounded-lg hover:border-green-500/50">
                <span>🚀 Ver Demo</span>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="text-center mt-12">
    <a href="https://github.com/adanwilliamdev" target="_blank" class="inline-flex items-center gap-2 px-8 py-4 bg-red-600/20 rounded-xl hover:bg-red-600/30 transition-all duration-300 border border-red-500/30 hover:border-red-500/60">
      Ver todos no GitHub →
    </a>
  </div>
</section>
