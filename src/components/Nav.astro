---
const links = [
  { href: "#about", label: "Trajetória" },
  { href: "#projects", label: "Projetos" },
  { href: "#stack", label: "Stack" },
];
---
<header class="fixed top-0 inset-x-0 z-50 border-b border-[var(--color-line-soft)] bg-[color-mix(in_oklab,var(--color-bg)_88%,transparent)] backdrop-blur-sm">
  <nav class="mx-auto max-w-5xl px-5 py-4 flex items-center justify-between">
    <a href="#top" class="font-[family-name:var(--font-mono)] text-sm text-[var(--color-ink)] tracking-tight">
      adan<span class="text-[var(--color-accent)]">.</span>william
    </a>

    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-[family-name:var(--font-mono)] text-xs uppercase tracking-wider link-accent"
        >
          {link.label}
        </a>
      ))}
    </div>

    <a
      href="mailto:adan.william.dev@gmail.com"
      class="btn-ghost px-4 py-2 rounded-md text-xs font-[family-name:var(--font-mono)] font-medium"
    >
      Contato
    </a>
  </nav>
</header>
