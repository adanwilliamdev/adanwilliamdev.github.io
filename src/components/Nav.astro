---
const links = [
  { href: "#about", label: "Sobre" },
  { href: "#experience", label: "Experiência" },
  { href: "#tech", label: "Stack" },
  { href: "#projects", label: "Projetos" },
];
---
<header class="fixed top-0 inset-x-0 z-50 px-3">
  <nav class="mx-auto max-w-6xl mt-3 px-4 py-2.5 rounded-2xl border border-line bg-bg/70 backdrop-blur-xl flex items-center justify-between">
    <a href="#top" class="font-mono text-sm tracking-tight flex items-center gap-2.5">
      <span class="live-dot"></span>
      adan<span class="text-signal">.</span>william
    </a>

    <div class="hidden md:flex items-center gap-1">
      {links.map((l) => (
        <a href={l.href} class="px-3 py-1.5 rounded-lg font-mono text-xs uppercase tracking-wider text-ink-dim hover:text-ink hover:bg-surface-2 transition-colors">{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button id="theme-toggle" type="button" aria-label="Alternar tema" class="btn-ghost w-9 h-9 rounded-lg grid place-items-center">
        <svg class="w-4 h-4 hidden [[data-theme=light]_&]:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="w-4 h-4 block [[data-theme=light]_&]:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4l1.4-1.4"/></svg>
      </button>
      <a href="mailto:adan.william.dev@gmail.com" class="btn-signal hidden sm:inline-flex px-4 py-2 rounded-lg text-xs font-mono">Contato</a>
      <button id="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden btn-ghost w-9 h-9 rounded-lg grid place-items-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="md:hidden mx-auto max-w-6xl mt-2 p-2 rounded-2xl border border-line bg-bg/90 backdrop-blur-xl">
    {links.map((l) => (
      <a href={l.href} class="block px-4 py-3 rounded-lg font-mono text-sm text-ink-dim hover:text-ink hover:bg-surface-2">{l.label}</a>
    ))}
    <a href="mailto:adan.william.dev@gmail.com" class="block px-4 py-3 rounded-lg font-mono text-sm text-signal">Contato</a>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
  });
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => { if (menu) menu.hidden = !open; btn?.setAttribute("aria-expanded", String(open)); };
  btn?.addEventListener("click", () => setOpen(menu!.hidden));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
