---
import Typewriter from "./Typewriter";
---
<section id="top" class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden pt-28">
  <div class="absolute inset-0 grid-field opacity-60"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--color-bg)]"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[640px] h-[320px] bg-[var(--color-signal)]/[0.07] rounded-full blur-[120px]"></div>

  <!-- Signal trace: a heartbeat/uptime line, the visual signature of the page -->
  <svg
    class="absolute inset-x-0 top-[38%] w-full h-32 opacity-[0.35]"
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
    fill="none"
  >
    <path
      class="signal-trace"
      d="M0,60 L280,60 L320,60 L345,20 L370,100 L395,40 L415,60 L520,60 L555,60 L580,15 L605,105 L630,60 L660,60 L900,60 L935,60 L960,25 L985,95 L1010,60 L1200,60"
      stroke="var(--color-signal)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>

  <div class="max-w-5xl mx-auto text-center relative z-10">
    <div class="fade-up mb-8 flex justify-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)]/70">
        <span class="live-dot"></span>
        <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-ink-dim)] tracking-wide">
          disponível para novos projetos
        </span>
      </span>
    </div>

    <h1 class="fade-up [animation-delay:0.05s] font-[family-name:var(--font-display)] text-5xl md:text-7xl font-bold text-[var(--color-ink)] mb-6 tracking-tight text-balance">
      Adan William
    </h1>

    <div class="fade-up [animation-delay:0.1s] text-xl md:text-2xl font-[family-name:var(--font-mono)] text-[var(--color-ink-dim)] mb-6 h-10 flex items-center justify-center">
      <Typewriter client:load />
    </div>

    <p class="fade-up [animation-delay:0.15s] text-lg md:text-xl text-[var(--color-signal)] font-medium max-w-2xl mx-auto mb-4">
      Desenvolvedor Full Stack com 5+ anos de experiência
    </p>

    <p class="fade-up [animation-delay:0.2s] text-base md:text-lg text-[var(--color-ink-dim)] max-w-2xl mx-auto mb-10 leading-relaxed">
      APIs escaláveis com <span class="text-[var(--color-ink)]">Java / Spring Boot</span>, interfaces modernas com <span class="text-[var(--color-ink)]">React / TypeScript</span> e uma base sólida em infraestrutura que prioriza <span class="text-[var(--color-ink)]">observabilidade</span> desde o primeiro commit.
    </p>

    <div class="fade-up [animation-delay:0.25s] flex flex-wrap gap-4 justify-center">
      <a href="#projects" class="btn-signal px-7 py-3.5 rounded-xl font-semibold">
        Ver projetos
      </a>
      <a href="https://www.linkedin.com/in/adan-william-9593163b3/" target="_blank" rel="noopener noreferrer" class="btn-ghost px-7 py-3.5 rounded-xl font-medium">
        LinkedIn
      </a>
      <a href="https://github.com/adanwilliamdev" target="_blank" rel="noopener noreferrer" class="btn-ghost px-7 py-3.5 rounded-xl font-medium">
        GitHub
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[var(--color-ink-faint)]">
    <span class="text-[10px] font-[family-name:var(--font-mono)] tracking-[0.3em]">SCROLL</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
