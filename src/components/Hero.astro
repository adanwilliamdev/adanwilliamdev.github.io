---
import Typewriter from "./Typewriter";
---
<section id="top" class="min-h-screen flex items-center px-5 pt-24">
  <div class="max-w-4xl mx-auto w-full">
    <div class="fade-up mb-6 flex items-center gap-2 font-[family-name:var(--font-mono)] text-xs text-[var(--color-ink-faint)] uppercase tracking-wider">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
      Pirapora, MG · Disponível para novos projetos
    </div>

    <h1 class="fade-up [animation-delay:0.05s] font-[family-name:var(--font-display)] text-5xl md:text-7xl font-bold text-[var(--color-ink)] mb-5 tracking-tight leading-[1.05]">
      Adan William
    </h1>

    <div class="fade-up [animation-delay:0.1s] text-xl md:text-2xl font-[family-name:var(--font-mono)] text-[var(--color-ink-dim)] mb-8 h-9">
      <Typewriter client:load />
    </div>

    <p class="fade-up [animation-delay:0.15s] text-base md:text-lg text-[var(--color-ink-dim)] max-w-xl mb-10 leading-relaxed">
      Construo APIs REST e sistemas corporativos com <span class="text-[var(--color-ink)]">Java / Spring Boot</span>, integrados a interfaces em <span class="text-[var(--color-ink)]">React / TypeScript</span> — com uma base de 5+ anos em infraestrutura que molda como penso disponibilidade e confiabilidade.
    </p>

    <div class="fade-up [animation-delay:0.2s] flex flex-wrap gap-3">
      <a href="#projects" class="btn-solid px-6 py-3 rounded-md font-semibold text-sm">
        Ver projetos
      </a>
      <a href="https://www.linkedin.com/in/adan-william-9593163b3/" target="_blank" rel="noopener noreferrer" class="btn-ghost px-6 py-3 rounded-md font-medium text-sm">
        LinkedIn
      </a>
      <a href="https://github.com/adanwilliamdev" target="_blank" rel="noopener noreferrer" class="btn-ghost px-6 py-3 rounded-md font-medium text-sm">
        GitHub
      </a>
    </div>
  </div>
</section>
