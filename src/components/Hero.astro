---
import Typewriter from "./Typewriter";
---
<section class="min-h-screen flex items-center justify-center px-4 relative overflow-hidden">
  <!-- Fundo -->
  <div class="absolute inset-0 bg-black"></div>
  <div class="absolute inset-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-red-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-red-600/5 rounded-full blur-3xl"></div>
  </div>
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>

  <div class="max-w-5xl mx-auto text-center relative z-10">
    <div class="mb-8 flex justify-center">
      <div class="w-24 h-24 rounded-full border-2 border-red-500 p-1 animate-float">
        <div class="w-full h-full rounded-full bg-black flex items-center justify-center text-4xl">
          👨‍💻
        </div>
      </div>
    </div>
    
    <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6 tracking-tight">
      Olá, eu sou <span class="text-red-500">Adan William</span>
    </h1>
    
    <!-- Typewriter com cursor integrado -->
    <div class="text-xl md:text-3xl font-mono text-zinc-300 mb-6 h-16 flex items-center justify-center">
      <Typewriter client:load />
    </div>
    
    <p class="text-xl md:text-2xl text-red-400 font-semibold max-w-2xl mx-auto mb-4">
      Desenvolvedor Full Stack com 5+ anos de experiência
    </p>
    
    <p class="text-lg md:text-xl text-zinc-400 max-w-3xl mx-auto mb-10 leading-relaxed">
      Desenvolvo APIs escaláveis com <span class="text-red-400">Java/Spring Boot</span>, aplicações web modernas com <span class="text-red-400">React/TypeScript</span> e soluções para ambientes corporativos com foco em <span class="text-red-400">observabilidade</span>.
    </p>
    
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="#projects" class="px-8 py-4 bg-red-600 rounded-xl font-semibold hover:bg-red-700 transition-all duration-300 shadow-lg shadow-red-500/25 hover:shadow-red-500/50 hover:scale-105">
        Ver Projetos ↓
      </a>
      <a href="https://www.linkedin.com/in/adan-william-9593163b3/" target="_blank" class="px-8 py-4 bg-white/5 rounded-xl font-semibold hover:bg-white/10 transition-all duration-300 border border-white/10 backdrop-blur-sm hover:border-red-500/50">
        LinkedIn
      </a>
      <a href="https://github.com/adanwilliamdev" target="_blank" class="px-8 py-4 bg-white/5 rounded-xl font-semibold hover:bg-white/10 transition-all duration-300 border border-white/10 backdrop-blur-sm hover:border-red-500/50">
        GitHub
      </a>
    </div>
  </div>
  
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-zinc-600 animate-bounce">
    <span class="text-xs font-mono tracking-widest">SCROLL</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
