---
import Typewriter from "./Typewriter";
import { projects } from "../data/projects";

const stats = [
  { value: "5+", label: "anos em infra & NOC" },
  { value: "12k+", label: "assinantes monitorados" },
  { value: String(projects.length), label: "projetos no GitHub" },
];
---
<section id="top" class="relative min-h-screen flex items-center px-4 pt-32 pb-20 overflow-hidden">
  <div class="absolute inset-0 grid-field"></div>
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-signal/15 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="relative z-10 max-w-6xl mx-auto w-full grid lg:grid-cols-[1.25fr_1fr] gap-14 items-center">
    <div>
      <span class="fade-up inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-line bg-surface/70 mb-8">
        <span class="live-dot"></span>
        <span class="font-mono text-xs text-ink-dim">disponível para novos projetos</span>
      </span>

      <h1 class="fade-up [animation-delay:.05s] text-5xl sm:text-6xl md:text-7xl font-semibold leading-[1.02] text-balance">
        Backend que <span class="text-gradient">não cai</span> em produção.
      </h1>

      <div class="fade-up [animation-delay:.1s] mt-6 h-8 font-mono text-lg md:text-xl text-signal flex items-center">
        <span class="text-ink-faint mr-2">&gt;</span><Typewriter client:load />
      </div>

      <p class="fade-up [animation-delay:.15s] mt-6 text-lg text-ink-dim max-w-xl leading-relaxed text-pretty">
        Sou <span class="text-ink">Adan William</span>. Depois de 5+ anos garantindo alta disponibilidade em ambientes críticos de ISP, migrei para o desenvolvimento: APIs assíncronas com <span class="text-ink">Python / FastAPI</span> e interfaces com <span class="text-ink">Next.js / TypeScript</span>, sempre com a mentalidade de <span class="text-ink">observabilidade</span> da infra.
      </p>

      <div class="fade-up [animation-delay:.2s] mt-9 flex flex-wrap gap-3">
        <a href="#projects" class="btn-signal px-6 py-3 rounded-xl">Ver projetos</a>
        <a href="https://github.com/adanwilliamdev" target="_blank" rel="noopener noreferrer" class="btn-ghost px-6 py-3 rounded-xl font-medium">GitHub</a>
        <a href="https://www.linkedin.com/in/awosantos/" target="_blank" rel="noopener noreferrer" class="btn-ghost px-6 py-3 rounded-xl font-medium">LinkedIn</a>
      </div>

      <dl class="fade-up [animation-delay:.25s] mt-12 flex flex-wrap gap-x-10 gap-y-4">
        {stats.map((s) => (
          <div>
            <dt class="text-3xl font-semibold tracking-tight">{s.value}</dt>
            <dd class="font-mono text-xs text-ink-faint mt-1">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="fade-up [animation-delay:.3s] hidden lg:block" aria-hidden="true">
      <div class="panel font-mono text-sm shadow-2xl shadow-black/30">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-line bg-surface-2/60">
          <span class="w-2.5 h-2.5 rounded-full bg-ink-faint/40"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-ink-faint/40"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-ink-faint/40"></span>
          <span class="ml-3 text-xs text-ink-faint">~/adan</span>
        </div>
        <div class="p-5 space-y-3 leading-relaxed">
          <p><span class="text-signal">$</span> whoami</p>
          <p class="text-ink-dim">adan-william · backend dev</p>
          <p><span class="text-signal">$</span> stack --now</p>
          <p class="text-ink-dim">python · fastapi · next.js · typescript<br />postgres · redis · docker</p>
          <p><span class="text-signal">$</span> background</p>
          <p class="text-ink-dim">isp · noc · zabbix · prtg · linux</p>
          <p><span class="text-signal">$</span> status</p>
          <p class="text-ink-dim flex items-center gap-2"><span class="live-dot"></span> aberto a oportunidades</p>
        </div>
      </div>
    </div>
  </div>
</section>
