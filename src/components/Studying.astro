---
const topics = [
  "Kubernetes",
  "Microsserviços",
  "AWS",
  "Arquitetura de Sistemas",
  "Observabilidade",
  "CI/CD",
  "Segurança",
  "OpenTelemetry",
];
---
<section id="studying" class="py-28 px-4 max-w-5xl mx-auto">
  <div class="mb-12 text-center">
    <span class="eyebrow">Aprendizado contínuo</span>
    <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl font-bold text-[var(--color-ink)] mt-4">
      O que estou estudando
    </h2>
    <p class="text-[var(--color-ink-dim)] mt-3">Sempre evoluindo e me atualizando.</p>
  </div>

  <div class="flex flex-wrap justify-center gap-3">
    {topics.map((item) => (
      <span class="tag !text-sm !px-4 !py-2 panel-hover">{item}</span>
    ))}
  </div>
</section>
