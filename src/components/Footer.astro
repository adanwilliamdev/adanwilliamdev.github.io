        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>
    </div>

    <p class="font-[family-name:var(--font-mono)] text-sm text-[var(--color-ink-faint)] mb-8">
      Building reliable software and scalable platforms
    </p>

    <div class="h-px w-16 mx-auto bg-[var(--color-line)] mb-8"></div>

    <p class="text-[var(--color-ink-faint)] text-xs font-[family-name:var(--font-mono)]">
      © {new Date().getFullYear()} Adan William
    </p>
  </div>
</footer>
